# Copy to .env and fill in. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional; defaults to the model set in lib/gemini.ts
GEMINI_MODEL=
# Optional AI sound generation via OpenRouter (server-side only; billed per clip)
OPENROUTER_API_KEY=
# Defaults to google/lyria-3-clip-preview (a music model; OpenRouter has no dedicated SFX model)
OPENROUTER_SFX_MODEL=

# DrawCover: server-side only. No NEXT_PUBLIC_ keys.
# Optional model overrides:
DRAWCOVER_METADATA_MODEL=
DRAWCOVER_IMAGE_MODEL=gemini-2.5-flash-image
OPENROUTER_MUSIC_MODEL=google/lyria-3-clip-preview
