# Copy this file to .env (or .env.local), then add ONE provider key or both.
# Both local files are ignored. Never add NEXT_PUBLIC_ to a key; restart after editing.

# Direct Google Gemini: recognition, album details, image editing AND Lyria music.
# Get a key / enable billing and model access: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: alternate route for all three capabilities. Credits/model access required.
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# auto | gemini | openrouter. auto prefers Gemini when its key exists.
# OpenRouter reads the drawing and generates metadata in one private vision request.
DRAWCOVER_METADATA_PROVIDER=
# Direct Gemini album-details model; default: GEMINI_MODEL or gemini-3.5-flash-lite.
DRAWCOVER_METADATA_MODEL=
# OpenRouter vision + structured-output model; default: google/gemini-3.5-flash-lite.
OPENROUTER_METADATA_MODEL=

# auto | gemini | openrouter | drawing. auto tries configured Gemini, then OpenRouter.
# An explicit provider does NOT spend credits at the other provider if it fails.
# drawing skips image AI and remixes the original drawing locally.
DRAWCOVER_IMAGE_PROVIDER=
# Direct image-editing model; default: gemini-3.1-flash-image.
DRAWCOVER_IMAGE_MODEL=
# OpenRouter image-input/output model; default: google/gemini-3.1-flash-image.
OPENROUTER_IMAGE_MODEL=

# auto | gemini | openrouter. auto prefers OpenRouter if its key exists (legacy behavior),
# otherwise direct Gemini. Music never automatically falls back to another paid provider.
DRAWCOVER_MUSIC_PROVIDER=
# Direct Gemini Interactions music model; default: lyria-3-clip-preview (30-second MP3).
DRAWCOVER_MUSIC_MODEL=
# OpenRouter music model; default: google/lyria-3-clip-preview (30-second MP3).
OPENROUTER_MUSIC_MODEL=

# Legacy /drawsound and direct DrawCover recognition; default: gemini-3.5-flash-lite.
GEMINI_MODEL=
# Legacy /drawsound opt-in AI audio only; default: google/lyria-3-clip-preview.
# It is a music model, not a dedicated realistic sound-effects model.
OPENROUTER_SFX_MODEL=
